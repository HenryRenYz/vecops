@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@VECOPS_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@VECOPS_MEMORY_HAVE_HWLOC@)
    find_dependency(PkgConfig)
    pkg_check_modules(HWLOC REQUIRED IMPORTED_TARGET hwloc>=2.7)
endif()

# A Python wheel relocates this config below vecops/_sdk. Keep sources used by
# optional out-of-line JIT leaves relative to that SDK prefix.
if(NOT DEFINED VECOPS_SOURCE_DIR)
    set(VECOPS_SOURCE_DIR "${PACKAGE_PREFIX_DIR}")
endif()

if(@VECOPS_ENABLE_KUPL_MMA@)
    set(VECOPS_ENABLE_KUPL_MMA ON)
    if(NOT DEFINED VECOPS_KUPL_INCLUDE_DIR)
        set(VECOPS_KUPL_INCLUDE_DIR "@VECOPS_KUPL_INCLUDE_DIR@")
    endif()
    if(NOT DEFINED VECOPS_KUPL_LIBRARY)
        set(VECOPS_KUPL_LIBRARY "@VECOPS_KUPL_LIBRARY@")
    endif()
    if(NOT TARGET KUPL::MMA)
        add_library(KUPL::MMA SHARED IMPORTED)
        set_target_properties(KUPL::MMA PROPERTIES
            IMPORTED_LOCATION "${VECOPS_KUPL_LIBRARY}"
            INTERFACE_INCLUDE_DIRECTORIES "${VECOPS_KUPL_INCLUDE_DIR}")
    endif()
endif()

# Preserve the richer native ARM contract detected while building the SDK.
# Some ARM compiler drivers (notably BiSheng) accept `-march=native` but omit
# SME and optional matrix extensions unless they are named explicitly.  A JIT
# consumer is a separate CMake project, so cache variables from the SDK build
# are otherwise unavailable to VecopsTargetArch.cmake.
if(NOT DEFINED VECOPS_MAP_ARM_Native)
    set(VECOPS_MAP_ARM_Native "@VECOPS_MAP_ARM_Native@")
endif()
if(NOT DEFINED VECOPS_MAP_ARM_NativeFixedSVE)
    set(VECOPS_MAP_ARM_NativeFixedSVE "@VECOPS_MAP_ARM_NativeFixedSVE@")
endif()
if(NOT DEFINED VECOPS_MAP_ARM_NativeFixedStreamingSVE)
    set(VECOPS_MAP_ARM_NativeFixedStreamingSVE
        "@VECOPS_MAP_ARM_NativeFixedStreamingSVE@")
endif()
if(NOT DEFINED VECOPS_NATIVE_HAS_SME)
    set(VECOPS_NATIVE_HAS_SME "@VECOPS_NATIVE_HAS_SME@")
endif()
if(NOT DEFINED VECOPS_NATIVE_HAS_SME_FA64)
    set(VECOPS_NATIVE_HAS_SME_FA64 "@VECOPS_NATIVE_HAS_SME_FA64@")
endif()
if(NOT DEFINED VECOPS_NATIVE_HAS_SME_F64F64)
    set(VECOPS_NATIVE_HAS_SME_F64F64 "@VECOPS_NATIVE_HAS_SME_F64F64@")
endif()
if(NOT DEFINED VECOPS_NATIVE_HAS_I8MM)
    set(VECOPS_NATIVE_HAS_I8MM "@VECOPS_NATIVE_HAS_I8MM@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VecopsTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VecopsKernelTargets.cmake")

set(Vecops_core_FOUND TRUE)
set(Vecops_runtime_FOUND TRUE)
if(TARGET vecops::compiler)
    set(Vecops_compiler_FOUND TRUE)
else()
    set(Vecops_compiler_FOUND FALSE)
endif()
if(TARGET vecops::memory)
    set(Vecops_memory_FOUND TRUE)
else()
    set(Vecops_memory_FOUND FALSE)
endif()

check_required_components(Vecops)
