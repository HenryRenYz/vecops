@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@VECOPS_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VecopsTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VecopsKernelTargets.cmake")

set(Vecops_core_FOUND TRUE)
set(Vecops_runtime_FOUND TRUE)
if(TARGET vecops::compiler)
    set(Vecops_compiler_FOUND TRUE)
else()
    set(Vecops_compiler_FOUND FALSE)
endif()

check_required_components(Vecops)
